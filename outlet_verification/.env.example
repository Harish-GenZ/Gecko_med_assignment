# Application Environment Configuration
APP_NAME="Outlet Verification System"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Connection (Railway PostgreSQL)
# For local development outside Railway network, use the public TCP proxy URL provided by Railway.
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_password_here@roundhouse.proxy.rlwy.net:12345/railway

# Railway / Tigris S3 Object Storage
ENDPOINT_URL=https://t3.storageapi.dev
Region=auto
Bucket_Name=shop-images-bucket-xxxxxx
ACCESS_KEY_ID=your_access_key_id
SECRET_ACCESS_KEY=your_secret_access_key

# Phase 4 Candidate Retrieval Settings
RETRIEVAL_NAME_TOP_K=5
RETRIEVAL_IMAGE_TOP_K=5
RETRIEVAL_GEO_RADIUS_METERS=500.0
RETRIEVAL_GEO_TOP_K=10

# Phase 5 Multimodal Verification Settings
VERIFICATION_NAME_WEIGHT=0.30
VERIFICATION_IMAGE_WEIGHT=0.45
VERIFICATION_GEO_WEIGHT=0.25
VERIFICATION_GEO_SCALE_METERS=100.0
VERIFICATION_DUPLICATE_THRESHOLD=0.75
VERIFICATION_REVIEW_THRESHOLD=0.65
VERIFICATION_GENUINE_THRESHOLD=0.65
VERIFICATION_REVIEW_MIN_COVERAGE=0.55
VERIFICATION_STRONG_IMAGE_THRESHOLD=0.90
VERIFICATION_STRONG_IMAGE_GEO_METERS=100.0
VERIFICATION_MIN_MARGIN=0.10
